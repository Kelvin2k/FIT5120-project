# Root gitignore for the FIT5120 project

# Java build outputs
/BackEnd_FIT5120/target/
/BackEnd_FIT5120/*.class
/BackEnd_FIT5120/**/*.class

# IDE and system files
.DS_Store
/.idea/
**/.DS_Store

# Node.js dependencies and build outputs
/FrontEnd_FIT5120/node_modules/
/FrontEnd_FIT5120/dist/
/FrontEnd_FIT5120/.vite/
/FrontEnd_FIT5120/.env
/FrontEnd_FIT5120/.env.*

# Vite cache
/FrontEnd_FIT5120/node_modules/
/FrontEnd_FIT5120/.vite/

# Logs
*.log

# Optional npm debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
